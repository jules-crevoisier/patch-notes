# =============================================================================
# .env.production — modèle pour un déploiement VPS Debian + Apache.
# -----------------------------------------------------------------------------
# 1) Copie ce fichier vers `.env` sur ton serveur (jamais versionné dans git).
# 2) Remplace TOUS les `change-me-...` par des valeurs solides.
# 3) Génère les secrets avec :  openssl rand -hex 32
#                               openssl rand -base64 24
# 4) Lance `./scripts/deploy.sh` — il valide tout au démarrage.
# 5) Configure les vhosts Apache + Certbot (cf. apache/README.md).
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (interne au réseau Docker, jamais exposé à Internet)
# -----------------------------------------------------------------------------
POSTGRES_USER=patchnotes
# REQUIS : 24+ caractères. `openssl rand -base64 24 | tr -d '/+='`
POSTGRES_PASSWORD=change-me-with-openssl-rand-base64-24
POSTGRES_DB=n8n
BLOG_DB=patch_notes
DATABASE_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Blog (SSR + API) — proxifié par Apache
# -----------------------------------------------------------------------------
# REQUIS : 32+ caractères. `openssl rand -hex 32`
# Sert à signer les requêtes n8n → blog. Doit être identique côté n8n.
BLOG_SECRET=change-me-with-openssl-rand-hex-32

# URL publique HTTPS du blog (utilisée pour sitemap, OG, hreflang).
SITE_URL=https://patch-notes.fr
SITE_NAME=patch-notes.fr
SITE_DESCRIPTION=Hub d'actualité par sujet : récaps courts, sources et liens utiles, mis à jour plusieurs fois par jour.
SITE_LOCALE=fr_FR
SITE_OG_IMAGE=https://patch-notes.fr/og.png

# -----------------------------------------------------------------------------
# n8n (proxifié par Apache + basic auth applicative)
# -----------------------------------------------------------------------------
# Le nom d'hôte public où Apache route vers le conteneur n8n.
# (Doit correspondre au ServerName dans apache/sites-available/n8n.patch-notes.fr.conf.)
N8N_HOST=n8n.patch-notes.fr

N8N_BASIC_AUTH_USER=admin
# REQUIS : 16+ caractères, accès admin total à tous tes workflows.
N8N_BASIC_AUTH_PASSWORD=change-me-strong-password

# REQUIS : 32+ caractères. `openssl rand -hex 32`
# Chiffre les credentials n8n stockés en base. NE JAMAIS CHANGER après le 1er run.
N8N_ENCRYPTION_KEY=change-me-with-openssl-rand-hex-32

GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris

# -----------------------------------------------------------------------------
# Gemini (Google AI Studio) — résumés et titres des récaps
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy-change-me
GEMINI_MODEL=gemini-flash-latest
# Quota effectif de ton plan Gemini (free tier = 5 RPM).
GEMINI_MAX_PER_MINUTE=5
GEMINI_MAX_WAIT_SECONDS=1800
