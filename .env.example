# =============================================================================
# Postgres — base unique patch_notes (articles, recaps, sujets).
# BLOG_DB est un alias optionnel si tu gardes un ancien POSTGRES_DB différent.
# =============================================================================
POSTGRES_USER=patchnotes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=patch_notes
BLOG_DB=patch_notes
DATABASE_POOL_SIZE=10

# =============================================================================
# Blog (serveur SSR + API)
# =============================================================================
BLOG_PORT=3001
BLOG_SECRET=change-me-blog-secret
# Clé HMAC utilisée pour hasher les IP avant stockage (pins publics /
# anti-spam suggestions). Jamais d'IP brute en base - cf. blog/pins.js.
IP_HASH_SECRET=change-me-ip-hash-secret
SITE_URL=http://localhost:3001
SITE_NAME=patch-notes.fr
SITE_DESCRIPTION=Hub d'actualité par sujet : récaps courts, sources et liens utiles, mis à jour plusieurs fois par jour.
SITE_LOCALE=fr_FR
# Image de partage social (Open Graph / Twitter). Fichier servi depuis blog/public/og.jpg.
# En prod : URL absolue HTTPS, ex. https://patch-notes.fr/og.jpg
SITE_OG_IMAGE=http://localhost:3001/og.jpg
# Code fourni par Google Search Console (balise HTML) pour prouver que tu possèdes le domaine.
# Laisser vide tant que la propriété n'est pas créée dans Search Console.
GOOGLE_SITE_VERIFICATION=

# =============================================================================
# Fuseau horaire (utilisé par le cron scheduler interne blog/automation/).
# =============================================================================
TZ=Europe/Paris

# =============================================================================
# Gemini (Google) - pour générer les titres et résumés des récaps.
# Le throttle est un file d'attente en mémoire dans le process blog
# (blog/automation/gemini-queue.js), plus de base partagée nécessaire.
# =============================================================================
GEMINI_API_KEY=
# Préférer `gemini-flash-latest` plutôt qu'une version pinnée : c'est un alias
# Google qui suit toujours la dernière flash stable et tolère mieux les pics de
# saturation (503 UNAVAILABLE) qu'un modèle figé.
GEMINI_MODEL=gemini-flash-latest
# Quota partagé global, en appels par minute. Mets le quota effectif de ton
# plan Gemini (free tier = 5 RPM pour gemini-flash-latest).
GEMINI_MAX_PER_MINUTE=5
# Garde-fou de sécurité : si jamais le calcul du prochain slot dépasse cette
# borne (en secondes), on refuse plutôt que d'attendre des heures. 1800s = 30min.
# Avec 5 RPM, ça permet de gérer ~150 sujets en file d'attente sans bloquer.
GEMINI_MAX_WAIT_SECONDS=1800
