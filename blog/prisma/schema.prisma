// Schéma Prisma pour le blog patch-notes.fr.
// Connexion sur la base patch_notes (créée par db/init/01-create-blog-db.sql).
// Les migrations sont versionnées dans prisma/migrations/ et appliquées par
// `prisma migrate deploy` au démarrage du conteneur (cf. Dockerfile).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  slug        String   @id
  label       String
  description String?
  mode        String   @default("fr-intl")
  isListed    Boolean  @default(true) @map("is_listed")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  posts     Post[]
  topicPins TopicPin[]

  @@map("topics")
}

model TopicPin {
  id        BigInt   @id @default(autoincrement())
  topicSlug String   @map("topic_slug")
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  topic Topic @relation(fields: [topicSlug], references: [slug], onDelete: Cascade)

  @@unique([topicSlug, ipHash], map: "topic_pins_topic_ip_key")
  @@map("topic_pins")
}

model Post {
  id           String   @id
  topicSlug    String   @map("topic_slug")
  title        String
  summary      String   @default("")
  slot         String?
  mode         String?
  sourceGroups Json     @default("{}") @map("source_groups")
  errors       Json     @default("[]")
  debug        Json     @default("{}")
  searchText   String   @default("") @map("search_text")
  pinCount     Int      @default(0) @map("pin_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  topic    Topic     @relation(fields: [topicSlug], references: [slug], onDelete: Cascade)
  articles Article[]
  pins     PostPin[]

  @@index([topicSlug, createdAt(sort: Desc)], map: "posts_topic_created_idx")
  @@index([createdAt(sort: Desc)], map: "posts_created_idx")
  @@map("posts")
}

model PostPin {
  id        BigInt   @id @default(autoincrement())
  postId    String   @map("post_id")
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, ipHash], map: "post_pins_post_ip_key")
  @@map("post_pins")
}

model Suggestion {
  id        BigInt   @id @default(autoincrement())
  text      String
  email     String?
  ipHash    String   @map("ip_hash")
  likeCount Int      @default(0) @map("like_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  likes SuggestionLike[]

  @@index([createdAt(sort: Desc)], map: "suggestions_created_idx")
  @@index([ipHash, createdAt], map: "suggestions_ip_created_idx")
  @@index([likeCount(sort: Desc), createdAt(sort: Desc)], map: "suggestions_like_count_created_idx")
  @@map("suggestions")
}

model SuggestionLike {
  id           BigInt   @id @default(autoincrement())
  suggestionId BigInt   @map("suggestion_id")
  ipHash       String   @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, ipHash], map: "suggestion_likes_suggestion_ip_key")
  @@map("suggestion_likes")
}

model Article {
  id          BigInt    @id @default(autoincrement())
  postId      String    @map("post_id")
  title       String
  url         String
  urlKey      String    @map("url_key")
  source      String?
  region      String?
  method      String?
  snippet     String?
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  position    Int       @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId], map: "articles_post_id_idx")
  @@index([urlKey], map: "articles_url_key_idx")
  @@map("articles")
}
